<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.youren.database.mapper.IdentityAccountMapper">
  <!-- 账号生命周期参与每次认证，读取不能仅验证令牌摘要。 -->
  <resultMap id="row" type="jp.youren.database.mapper.IdentityAccountMapper$IdentityRow"><constructor>
    <idArg column="id" javaType="java.util.UUID" typeHandler="jp.youren.database.type.UuidTypeHandler"/>
    <arg column="email_normalized" javaType="java.lang.String"/><arg column="status" javaType="java.lang.String"/>
  </constructor></resultMap>
  <resultMap id="settings" type="jp.youren.database.mapper.IdentityAccountMapper$SettingsRow"><constructor>
    <arg column="allow_stranger_dm" javaType="_boolean"/><arg column="push_enabled" javaType="_boolean"/><arg column="lockscreen_preview" javaType="_boolean"/>
  </constructor></resultMap>
  <select id="findEmail" resultMap="row" timeout="2">SELECT id,email_normalized,status FROM accounts WHERE email_normalized=#{email}</select>
  <select id="find" resultMap="row" timeout="2">SELECT id,email_normalized,status FROM accounts WHERE id=#{id}</select>
  <select id="lock" resultMap="row" timeout="3" flushCache="true" useCache="false">SELECT id,email_normalized,status FROM accounts WHERE id=#{id} FOR UPDATE</select>
  <insert id="insert" timeout="2">INSERT INTO accounts(id,email_normalized,created_at,updated_at) VALUES(#{id},#{email},#{now},#{now})</insert>
  <!-- 新注册只初始化合同默认值，已有账号不覆盖设置。 -->
  <insert id="initializeSettings" timeout="2">INSERT INTO account_settings(account_id,created_at,updated_at) VALUES(#{accountId},#{now},#{now})</insert>
  <insert id="initializePrincipal" timeout="2">INSERT INTO principals(id,kind,account_id,created_at,updated_at) VALUES(#{id},'account',#{accountId},#{now},#{now})</insert>
  <select id="settings" resultMap="settings" timeout="2">SELECT allow_stranger_dm,push_enabled,lockscreen_preview FROM account_settings WHERE account_id=#{accountId}</select>
</mapper>
