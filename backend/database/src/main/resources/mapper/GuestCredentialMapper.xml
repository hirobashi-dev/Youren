<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.youren.database.mapper.GuestCredentialMapper">
  <!-- 内部行模型不公开；UUID及UTC到期时间显式映射到构造参数。 -->
  <resultMap id="credential" type="jp.youren.database.mapper.GuestCredentialMapper$GuestCredentialRow">
    <constructor>
      <idArg column="id" javaType="java.util.UUID" typeHandler="jp.youren.database.type.UuidTypeHandler"/>
      <arg column="principal_id" javaType="java.util.UUID" typeHandler="jp.youren.database.type.UuidTypeHandler"/>
      <arg column="secret_hash" javaType="java.lang.String"/>
      <arg column="expires_at" javaType="java.time.OffsetDateTime"/>
    </constructor>
  </resultMap>
  <!-- 全部外部值使用参数绑定；服务端时间同时用于主体与凭证，避免TTL漂移。 -->
  <insert id="insertPrincipal" timeout="2">
    INSERT INTO principals(id,kind,created_at,updated_at) VALUES (#{id},'guest',#{createdAt},#{createdAt})
  </insert>
  <insert id="insertCredential" timeout="2">
    INSERT INTO guest_credentials(id,principal_id,secret_hash,created_at,updated_at,last_used_at,expires_at)
    VALUES (#{id},#{principalId},#{secretHash},#{createdAt},#{createdAt},#{createdAt},#{expiresAt})
  </insert>
  <!-- 到期边界用严格大于；撤销和接续后不能再凭游客秘密获得主体权限。 -->
  <select id="findActive" resultMap="credential" timeout="2">
    SELECT g.id,g.principal_id,g.secret_hash,g.expires_at FROM guest_credentials g
    JOIN principals p ON p.id=g.principal_id
    WHERE g.secret_hash=#{secretHash} AND g.revoked_at IS NULL AND g.expires_at &gt; #{now}
      AND p.kind='guest' AND p.account_id IS NULL AND p.claimed_at IS NULL
  </select>
  <!-- 重复撤销保留首次时间；摘要不能作为原秘密返回客户端。 -->
  <update id="revoke" timeout="2">
    UPDATE guest_credentials SET revoked_at=#{now},updated_at=#{now}
    WHERE secret_hash=#{secretHash} AND revoked_at IS NULL
  </update>
</mapper>
